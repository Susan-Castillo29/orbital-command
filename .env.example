# Private NASA key, used only by the server or snapshot update script.
NASA_API_KEY=
# These two values are intentionally public in the browser. Never use a service-role or secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# URL pública del backend ORBITAL GAMIFICATION API v1 (cliente browser).
VITE_ORBITAL_PLATFORM_API_URL=
# Solo servidor: una clave independiente por equipo, separadas por coma.
# Genera claves aleatorias de al menos 32 bytes; nunca las pongas en VITE_*.
ORBITAL_API_KEYS=
# Solo servidor: URL del sitio cliente, incluido el subpath de GitHub Pages si aplica.
ORBITAL_APP_URL=https://susan-castillo29.github.io/orbital-command
# Solo servidor: lista exacta de origins permitidos, separada por coma.
ORBITAL_ALLOWED_ORIGINS=https://susan-castillo29.github.io
# Solo servidor: usar service_role/JWT en entorno protegido; jamás publicar.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
