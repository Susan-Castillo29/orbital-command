{
  "name": "orbital-command",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve": "node server/nasa-proxy.mjs",
    "nasa:update": "node scripts/update-nasa-snapshots.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-e2e.cjs",
    "test:accessibility": "node tests/browser-accessibility.cjs",
    "test:impact": "node tests/browser-impact.cjs",
    "test:engineering": "node tests/browser-engineering.cjs",
    "test:reliability": "node tests/browser-reliability.cjs",
    "test:campaign": "node tests/browser-campaign-legacy.cjs",
    "test:telescope": "node tests/browser-telescope-mode.cjs",
    "test:exploration-failure": "node tests/browser-exploration-failure.cjs",
    "test:lab-language": "node tests/browser-lab-language.cjs",
    "test:report-language": "node tests/browser-report-language.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.177.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "4.14.0",
    "playwright": "1.56.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
